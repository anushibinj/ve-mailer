flowchart TD
    subgraph Frontend["Frontend (React + Vite)"]
        LP[Login Page]
        SP[Signup Page]
        VP[Verify OTP Page]
        FP[Forgot Password Page]
        RP[Reset Password Page]
        AC[Auth Context]
        PR[Protected Routes]
        LV[Landing View]
        WD[Workspace Dashboard]
        FB[Filter Builder]
        ACP[Admin Control Panel]
        NPP[Notification Preferences Page]
        AIPP[AI Preferences Page]
        WMP[Workspace Management Page]
        MAP[Mail Analytics Page]
        AI[Axios Interceptors]
    end

    subgraph Backend["Backend (Spring Boot)"]
        subgraph Security["Security Layer"]
            JF[JWT Auth Filter]
            SC[Security Config]
            AE[Auth401EntryPoint — 401 for unauthenticated]
            ADH[Auth403AccessDeniedHandler — 403 for access denied]
        end

        subgraph AuthModule["Authentication Module"]
            ACtrl[Auth Controller]
            AS[Auth Service]
            JWT[JWT Service]
            RTS[Refresh Token Service]
            UDS[UserDetails Service]
            ABS[Admin Bootstrap]
        end

        subgraph BusinessModule["Business Module"]
            WCtrl[Workspace Controller]
            FCtrl[Filter Controller]
            SCtrl[Subscription Controller]
            NPCtrl[Notification Preferences Controller]
            AIPCtrl[AI Preferences Controller]
            MACtrl[Mail Analytics Controller]
            FS[Filter Service]
            SS[Subscription Service]
            NPS[Notification Preferences Service]
            APS[AI Preferences Service]
            DMS[Dynamic Mail Sender Service]
            DAIS[Dynamic AI Client Service]
            OTP[OTP Service]
            PS[Polling Service]
            NS[Notification Service]
            AIS[AI Summary Service]
            TCS[Ticket Comment Service]
            MAS[Mail Analytics Service]
            MAUS[Mail Audit Service]
        end

        subgraph DataLayer["Data Layer (JPA)"]
            UR[AppUser Repository]
            RR[Role Repository]
            RTR[RefreshToken Repository]
            OTPR[OtpRequest Repository]
            FR[Filter Repository]
            WR[Workspace Repository]
            ESR[EmailSubscriber Repository]
            NPR[NotificationPreferences Repository]
            APR[AiPreferences Repository]
            MALR[MailAuditLog Repository]
        end
    end

    subgraph External["External Services"]
        DB[(H2 / PostgreSQL)]
        SMTP[SMTP Server]
        VE[ValueEdge / Octane API]
        OPENAI[OpenAI API]
    end

    %% Frontend flows
    LP --> AI
    SP --> AI
    VP --> AI
    FP --> AI
    RP --> AI
    AI --> ACtrl
    AC --> PR
    PR --> LV
    PR --> WD
    PR --> FB
    PR --> ACP
    ACP --> NPP
    ACP --> AIPP
    ACP --> WMP
    ACP --> MAP
    NPP --> AI
    AIPP --> AI
    WMP --> AI
    MAP --> AI
    LV --> AI
    WD --> AI
    FB --> AI
    AI --> WCtrl
    AI --> FCtrl
    AI --> SCtrl
    AI --> NPCtrl
    AI --> AIPCtrl
    AI --> MACtrl

    %% Security flow
    JF --> JWT
    JF --> UDS
    SC --> JF
    SC --> AE
    SC --> ADH
    AE -->|HTTP 403 JSON| AI
    ADH -->|HTTP 403 JSON| AI
    AI -->|auth:session-expired event| AC

    %% Auth flows
    ACtrl --> AS
    AS --> JWT
    AS --> RTS
    AS --> OTP
    AS --> UR
    ABS --> UR
    ABS --> RR
    UDS --> UR

    %% Business flows
    FCtrl --> FS
    SCtrl --> SS
    NPCtrl --> NPS
    AIPCtrl --> APS
    NPS --> NPR
    APS --> APR
    DMS --> NPS
    SS --> OTP
    OTP --> OTPR
    OTP --> DMS
    OTP --> SMTP
    FS --> VE
    PS --> FS
    PS --> NS
    NS --> AIS
    AIS --> DAIS
    DAIS --> APR
    AIS --> TCS
    TCS --> VE
    AIS --> DAIS
    DAIS --> OPENAI
    NS --> DMS
    DMS --> SMTP
    NS --> MAUS
    MAUS --> MALR
    MACtrl --> MAS
    MAS --> MALR

    %% Data layer
    UR --> DB
    RR --> DB
    RTR --> DB
    OTPR --> DB
    FR --> DB
    WR --> DB
    ESR --> DB
    NPR --> DB
    APR --> DB
    MALR --> DB
    RTS --> RTR
