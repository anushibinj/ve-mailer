# Backend (Spring Boot) environment variables
# Copy this file to .env and fill in real values

# OpenAI API Key for AI Summary feature
OPENAI_API_KEY=YOUR_API_KEY

# Comma-separated list of Octane reference fields that should resolve values from /list_nodes/ui_bundle
VE_MAILER_OCTANE_UI_BUNDLE_FIELD_NAMES=product_udf

# Maximum issue screenshot upload size in bytes (stored as BYTEA) (~1 MB)
VE_MAILER_ISSUES_MAX_SCREENSHOT_BYTES=1048576
VE_MAILER_ISSUES_MAX_UPLOAD_BYTES=5242880
VE_MAILER_ISSUES_MULTIPART_MAX_FILE_SIZE=10MB
VE_MAILER_ISSUES_MULTIPART_MAX_REQUEST_SIZE=10MB

# Octane request header hpeclienttype=HPE_MQM_UI is always applied by the backend code.

# Workspace Title and Workspace Shortcode are no longer entered manually — the workspace
# creation wizard auto-discovers them from the ValueEdge REST API (GET /api/shared_spaces/
# {sharedSpaceId}/workspaces?fields=name) using the Client ID/Key entered in Step 2. If the
# shortcode cannot be confidently parsed from the discovered name, it is stored as "UNKNOWN"
# and the workspace is created as Draft (Super Admins are emailed for manual review).

# Frontend URL used by backend invite emails
VE_MAILER_FRONTEND_URL=http://localhost:5173
VE_MAILER_AUTH_INVITE_LINK_EXPIRATION_MINUTES=10
VE_MAILER_AUTH_INVITE_LINK_BASE_RESEND_SECONDS=30

# Frontend environment variables (used in frontend/.env)
VITE_BACKEND_ROOT_URL=http://localhost:8080

VITE_BASE_PATH=/
VITE_ALLOW_CUSTOM_QUERY_STRING=false
